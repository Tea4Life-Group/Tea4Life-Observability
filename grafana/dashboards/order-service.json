{
  "uid": "tea4life-order-service",
  "title": "Tea4Life Order Service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["tea4life", "spring-boot", "order-service"],
  "panels": [
    {"id":1,"type":"stat","title":"Service Up","gridPos":{"h":4,"w":4,"x":0,"y":0},"targets":[{"expr":"up{job=\"order-service\"}","legendFormat":"{{instance}}"}],"fieldConfig":{"defaults":{"unit":"none","thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}}},
    {"id":2,"type":"timeseries","title":"Requests / sec","gridPos":{"h":8,"w":8,"x":4,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{service=\"order-service\"}[1m]))","legendFormat":"req/s"}],"fieldConfig":{"defaults":{"unit":"reqps"}}},
    {"id":3,"type":"timeseries","title":"Error Rate","gridPos":{"h":8,"w":8,"x":12,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{service=\"order-service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"order-service\"}[5m])), 0.001)","legendFormat":"5xx / total"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
    {"id":4,"type":"timeseries","title":"JVM Memory Used","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum(jvm_memory_used_bytes{service=\"order-service\"})","legendFormat":"used"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":5,"type":"timeseries","title":"API Throughput by Status","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sum by (status) (rate(http_server_requests_seconds_count{service=\"order-service\"}[1m]))","legendFormat":"{{status}}"}],"fieldConfig":{"defaults":{"unit":"reqps"}}},
    {"id":6,"type":"timeseries","title":"Response Time p50 / p95 / p99","gridPos":{"h":8,"w":12,"x":0,"y":16},"targets":[{"expr":"histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"order-service\"}[5m])))","legendFormat":"p50"},{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"order-service\"}[5m])))","legendFormat":"p95"},{"expr":"histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"order-service\"}[5m])))","legendFormat":"p99"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":7,"type":"bargauge","title":"Slowest URI p95","gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"topk(10, histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{service=\"order-service\",uri!=\"UNKNOWN\"}[5m]))))","legendFormat":"{{method}} {{uri}}"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":8,"type":"bargauge","title":"Top URI Request Rate","gridPos":{"h":8,"w":12,"x":0,"y":24},"targets":[{"expr":"topk(10, sum by (method, uri) (rate(http_server_requests_seconds_count{service=\"order-service\",uri!=\"UNKNOWN\"}[1m])))","legendFormat":"{{method}} {{uri}}"}],"fieldConfig":{"defaults":{"unit":"reqps"}}},
    {"id":9,"type":"timeseries","title":"JVM Memory by Area","gridPos":{"h":8,"w":12,"x":12,"y":24},"targets":[{"expr":"sum by (area) (jvm_memory_used_bytes{service=\"order-service\"})","legendFormat":"{{area}} used"},{"expr":"sum by (area) (jvm_memory_max_bytes{service=\"order-service\"})","legendFormat":"{{area}} max"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":10,"type":"timeseries","title":"HikariCP Connections","gridPos":{"h":8,"w":12,"x":0,"y":32},"targets":[{"expr":"sum(hikaricp_connections_active{service=\"order-service\"})","legendFormat":"active"},{"expr":"sum(hikaricp_connections_idle{service=\"order-service\"})","legendFormat":"idle"},{"expr":"sum(hikaricp_connections_pending{service=\"order-service\"})","legendFormat":"pending"}],"fieldConfig":{"defaults":{"unit":"none"}}},
    {"id":11,"type":"timeseries","title":"CPU Usage","gridPos":{"h":8,"w":12,"x":12,"y":32},"targets":[{"expr":"process_cpu_usage{service=\"order-service\"}","legendFormat":"process"},{"expr":"system_cpu_usage{service=\"order-service\"}","legendFormat":"system"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}}
  ]
}
